# Build output
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
artifacts/
publish/

# Rider / Visual Studio / VS Code
.vs/
.idea/
.vscode/
.config/
*.user
*.suo
*.DotSettings

# OS
Thumbs.db
.DS_Store

# Runtime data produced next to the repo root
/Cache
*.log

# Only data files and scripts live in bin; everything else is generated,
# user data, or downloaded at runtime.
bin/*
!bin/*.ps1
!bin/*.cmd
!bin/7-Zip/
!bin/7-Zip/**

# The software list ships as a template; Config holds nothing but user data.
# The placeholder keeps the folder in a fresh clone, which is what selects
# portable mode, so each worktree keeps its own settings instead of sharing
# one roaming folder.
!bin/Config/
bin/Config/*
!bin/Config/.gitkeep
!bin/Templates/
!bin/Templates/**

# Offline installers for the CLI tools, kept here so a lost download directory can
# be restocked. Copies of these live next to the downloads they install.
!bin/InstallScripts/
!bin/InstallScripts/**
!bin/Assets/
!bin/Assets/**
