# OS
Thumbs.db
.DS_Store

# Runtime data produced next to the repo root
/Cache
*.log

# Only data files and scripts live in bin; everything else is generated,
# user data, or downloaded at runtime.
bin/*
!bin/*.ps1
!bin/*.cmd
!bin/7-Zip/
!bin/7-Zip/**

# The software list ships with the app; the rest of Config is user data.
!bin/Config/
bin/Config/*
!bin/Config/Software.tab
