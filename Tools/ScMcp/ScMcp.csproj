<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScMcp</AssemblyName>
    <RootNamespace>ScMcp</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Ships beside the app: the adapter derives the instance id from its own folder. -->
    <OutDir>..\..\bin</OutDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Single source of truth for the pipe name and the tool catalogue, shared with the app. -->
    <Compile Include="..\..\SoftwareCrawler\Services\McpPipeNames.cs" Link="McpPipeNames.cs" />
    <Compile Include="..\..\SoftwareCrawler\Services\DebugMcpContract.cs" Link="DebugMcpContract.cs" />
  </ItemGroup>
</Project>
