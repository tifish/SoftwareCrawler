Flutter	https://docs.flutter.cn/install/manual		async function downloadFlutterStable() {`n  // The docs page paints its download link from script and often never gets to it.`n  // The release manifest names the same archive without the page's help: one JSON,`n  // whose current_release.stable points at the release to navigate to.`n  const manifestUrl = "https://storage.googleapis.com/flutter_infra_release/releases/releases_windows.json";`n`n  function wait(ms) {`n    return new Promise((resolve) => setTimeout(resolve, ms));`n  }`n`n  for (let attempt = 0; attempt < 12; attempt++) {`n    try {`n      const resp = await fetch(manifestUrl, { cache: "no-store", signal: AbortSignal.timeout(15000) });`n      if (resp.ok) {`n        const data = await resp.json();`n        const hash = data.current_release && data.current_release.stable;`n        const release = (data.releases || []).find((r) => r.hash === hash && r.channel === "stable");`n        if (release && release.archive) {`n          const url = data.base_url + "/" + release.archive;`n          console.log("Flutter script: navigate to " + url);`n          location.href = url;`n          return;`n        }`n      }`n    } catch (e) {`n      console.log("Flutter script: manifest fetch failed: " + e);`n    }`n    await wait(5000);`n  }`n  throw new Error("Flutter release manifest lookup failed on all attempts");`n}`ndownloadFlutterStable();							300	*.zip			
