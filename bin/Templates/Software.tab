Nvidia 游戏驱动程序	https://www.nvidia.cn/geforce/drivers		async function downloadNvidiaDriver() {`n  // Query NVIDIA's driver service directly instead of relying on the page's own`n  // lookup script: that one silently leaves a placeholder href when its request`n  // fails, and its hardcoded gfwsl.geforce.com host is unreliable at night from`n  // China. The .cn mirror is tried first, alternating with the global host.`n  const apiQuery = "func=DriverManualLookup&psid=127&pfid=995&osID=135&languageCode=2052&dch=1&numberOfResults=1";`n  const apiPath = "/services_toolkit/services/com/nvidia/services/AjaxDriverService.php?";`n  const hosts = ["https://gfwsl.geforce.cn", "https://gfwsl.geforce.com"];`n`n  function wait(ms) {`n    return new Promise((resolve) => setTimeout(resolve, ms));`n  }`n`n  for (let attempt = 0; attempt < 16; attempt++) {`n    const host = hosts[attempt % hosts.length];`n    try {`n      const resp = await fetch(host + apiPath + apiQuery, { signal: AbortSignal.timeout(10000) });`n      if (resp.ok) {`n        const data = await resp.json();`n        const info = data && data.IDS && data.IDS[0] && data.IDS[0].downloadInfo;`n        const url = (info && info.DownloadURL) || "";`n        if (url.indexOf(".exe") !== -1) {`n          console.log("NVIDIA script: navigate to " + url);`n          location.href = url;`n          return;`n        }`n      }`n    } catch (e) {`n      console.log("NVIDIA script: lookup failed on " + host + ": " + e);`n    }`n    await wait(5000);`n  }`n  throw new Error("NVIDIA driver lookup failed on all attempts");`n}`ndownloadNvidiaDriver();							300	*-desktop-*-international-dch-whql.exe			
Nvidia 工作室驱动程序	https://www.nvidia.cn/geforce/drivers		async function downloadNvidiaDriver() {`n  // Query NVIDIA's driver service directly instead of relying on the page's own`n  // lookup script: that one silently leaves a placeholder href when its request`n  // fails, and its hardcoded gfwsl.geforce.com host is unreliable at night from`n  // China. The .cn mirror is tried first, alternating with the global host.`n  const apiQuery = "func=DriverManualLookup&psid=127&pfid=995&upCRD=1&osID=135&languageCode=2052&dch=1&numberOfResults=1";`n  const apiPath = "/services_toolkit/services/com/nvidia/services/AjaxDriverService.php?";`n  const hosts = ["https://gfwsl.geforce.cn", "https://gfwsl.geforce.com"];`n`n  function wait(ms) {`n    return new Promise((resolve) => setTimeout(resolve, ms));`n  }`n`n  for (let attempt = 0; attempt < 16; attempt++) {`n    const host = hosts[attempt % hosts.length];`n    try {`n      const resp = await fetch(host + apiPath + apiQuery, { signal: AbortSignal.timeout(10000) });`n      if (resp.ok) {`n        const data = await resp.json();`n        const info = data && data.IDS && data.IDS[0] && data.IDS[0].downloadInfo;`n        const url = (info && info.DownloadURL) || "";`n        if (url.indexOf(".exe") !== -1) {`n          console.log("NVIDIA script: navigate to " + url);`n          location.href = url;`n          return;`n        }`n      }`n    } catch (e) {`n      console.log("NVIDIA script: lookup failed on " + host + ": " + e);`n    }`n    await wait(5000);`n  }`n  throw new Error("NVIDIA driver lookup failed on all attempts");`n}`ndownloadNvidiaDriver();							300	*-nsd-*.exe			
