Codex Desktop	https://store.rg-adguard.net/		(async function () {`n    // The Store's real distribution channel is Windows Update. store.rg-adguard.net`n    // runs the FE3 SOAP dance (GetCookie -> SyncUpdates -> GetExtendedUpdateInfo2)`n    // for a Store ProductId and hands back the signed dl.delivery.mp.microsoft.com`n    // links the Store itself downloads from. OpenAI's own ChatGPT-x64.msix blob is`n    // a stale snapshot of the same Store-signed package - nothing updates it. This`n    // page is only here to give the POST a same-origin caller that clears the site's`n    // bot check.`n    async function lookup() {`n        const response = await fetch("/api/GetFiles", {`n            method: "POST",`n            headers: { "Content-Type": "application/x-www-form-urlencoded" },`n            body: new URLSearchParams({`n                type: "ProductId",`n                url: "9PLM9XGG6VKS", // ChatGPT, package identity OpenAI.Codex`n                ring: "Retail",`n                lang: "en-US"`n            }).toString()`n        });`n        if (!response.ok) return null;`n`n        // The reply lists every architecture plus the BlockMap sidecars. Keep the`n        // x64 .msix rows - the file name carries the version.`n        const doc = new DOMParser().parseFromString(await response.text(), "text/html");`n        const packages = Array.from(doc.querySelectorAll("a[href]"))`n            .map(function (a) {`n                const match = a.textContent.trim().match(/^OpenAI\.Codex_(\d[\d.]*)_x64__[a-z0-9]+\.msix$/i);`n                return match ? { href: a.href, version: match[1].split(".").map(Number) } : null;`n            })`n            .filter(function (p) { return p !== null; });`n        return packages.length > 0 ? packages : null;`n    }`n`n    // A cold browser profile gets the bot challenge instead of the table on its`n    // first requests. It clears itself within a minute, so wait it out here rather`n    // than spending a whole pipeline retry - each of those reloads the page and`n    // starts the challenge over.`n    let packages = null;`n    for (let attempt = 0; attempt < 20 && packages === null; attempt++) {`n        if (attempt > 0)`n            await new Promise(function (resolve) { setTimeout(resolve, 5000); });`n        try {`n            packages = await lookup();`n        } catch (error) {`n            console.log("GetFiles attempt " + (attempt + 1) + " failed: " + error);`n        }`n    }`n    if (packages === null) throw new Error("No x64 msix from the FE3 lookup");`n`n    packages.sort(function (a, b) {`n        for (let i = 0; i < Math.max(a.version.length, b.version.length); i++) {`n            const diff = (b.version[i] || 0) - (a.version[i] || 0);`n            if (diff !== 0) return diff;`n        }`n        return 0;`n    });`n`n    // The link is signed and expires within the hour, so it has to be followed now`n    // rather than stored in the recipe as a DirectDownload URL.`n    window.location.href = packages[0].href;`n})();							180	*.msix			
