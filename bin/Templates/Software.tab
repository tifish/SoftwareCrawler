ScreenToGif	https://nicke.tech/screentogif/downloads		(async function () {`n    // Match the icon, not the label: the page follows Accept-Language, so`n    // "Get Installer" shows up translated. icon-archive-regular is the MSI`n    // installer, icon-box-regular the MSIX and icon-usb-stick-regular the ZIP.`n    function findButton() {`n        return document.evaluate(`n            "//button[.//i[contains(@class, 'icon-archive-regular')]]",`n            document,`n            null,`n            XPathResult.FIRST_ORDERED_NODE_TYPE,`n            null`n        ).singleNodeValue;`n    }`n`n    let button = null;`n    for (let i = 0; i < 30; i++) {`n        button = findButton();`n        if (button) break;`n        await new Promise(function (r) { setTimeout(r, 1000); });`n    }`n    if (!button) throw new Error("Installer button not found");`n`n    // The page hands the file over via a detached <a target="_blank" download>`n    // pointing at GitHub: the popup never opens without a user gesture and the`n    // download attribute is ignored cross-origin, so nothing downloads. Capture`n    // the URL instead and load it in this window.`n    const originalClick = HTMLAnchorElement.prototype.click;`n    let url = "";`n    HTMLAnchorElement.prototype.click = function () {`n        if (this.href) url = this.href;`n    };`n    try {`n        button.click();`n    } finally {`n        HTMLAnchorElement.prototype.click = originalClick;`n    }`n`n    if (!url) throw new Error("Download URL not captured");`n    window.location.href = url;`n})();								*.msi			
