WPS Comate	https://comate.wps.cn/		async function downloadWindows() {`n  const response = await fetch("/release/api/v1/download/get_url", {`n    method: "POST",`n    headers: { "Content-Type": "application/json" },`n    body: JSON.stringify({ channelid: 3, platform: "windows-x86_64" })`n  });`n  if (!response.ok) {`n    throw new Error("WPS Comate API returned " + response.status);`n  }`n  const result = await response.json();`n  const url = result && result.code === 0 && result.data && result.data.url;`n  if (!url) {`n    throw new Error("Invalid WPS Comate download response");`n  }`n  location.href = url;`n}`n`ndownloadWindows();								*.exe			
T3 Code	https://github.com/pingdotgg/t3code/releases/latest		async function executeSteps() {`n  // GitHub loads the assets list lazily (include-fragment loading="lazy");`n  // it never fetches until scrolled into view, so scroll it every round.`n  for (let i = 0; i < 30; i++) {`n    const link = document.querySelector(`n      "a[href*='/releases/download/'][href$='-x64.exe']"`n    );`n    if (link) {`n      link.scrollIntoView();`n      link.click();`n      return;`n    }`n`n    const fragment = document.querySelector(`n      "include-fragment[src*='expanded_assets']"`n    );`n    if (fragment) {`n      fragment.scrollIntoView();`n    }`n`n    await new Promise((r) => setTimeout(r, 1000));`n  }`n`n  throw new Error("x64.exe asset link not found");`n}`n`nexecuteSteps();								*.exe			
